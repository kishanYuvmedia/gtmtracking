# Backend - Development (backend/.env)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/gtmtracking
# Dev database. Outside NODE_ENV=production the backend connects here instead of MONGODB_URI,
# and seed/migration scripts refuse to run unless it is set and names a dev/test database.
DATABASE_URL_DEV=mongodb://localhost:27017/cdp_dev
REDIS_URL=redis://localhost:6379
INGESTION_RATE_LIMIT=600
JWT_SECRET=your-dev-jwt-secret
META_APP_ID=
META_APP_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
CDN_URL=http://localhost:4000
COLLECTOR_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Frontend - Development (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production (backend/.env.production)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
# JWT_SECRET=your-production-jwt-secret
# CDN_URL=https://yourdomain.com
# COLLECTOR_URL=https://yourdomain.com
# APP_URL=https://yourdomain.com

# Email / OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@clickowl.com
