{
  "name": "gtmtracking-backend",
  "version": "1.0.0",
  "description": "GTM Tracking - Server Side Tracking & Conversion API Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit --strict --target ES2022 --module commonjs --esModuleInterop --skipLibCheck --types node --moduleResolution node scripts/migrations/backfill-cdp-workspaces.ts scripts/migrations/migrate-dev.ts scripts/migrations/rerun-identity.ts scripts/seed/seed-cdp.ts",
    "migrate:cdp-backfill": "tsx scripts/migrations/backfill-cdp-workspaces.ts",
    "seed:cdp": "tsx scripts/seed/seed-cdp.ts",
    "migrate:dev": "tsx scripts/migrations/migrate-dev.ts",
    "identity:rerun": "tsx scripts/migrations/rerun-identity.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:verify": "tsx scripts/seed/verify-seed-in-memory.ts",
    "migrate:prod": "node dist/migrations/production.js"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.1",
    "nodemailer": "^10.2.1",
    "typescript": "^5.5.4",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4"
  }
}
